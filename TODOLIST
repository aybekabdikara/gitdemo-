<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Матрица">
<meta name="theme-color" content="#3F6B4F">
<meta name="description" content="Матрица Эйзенхауэра: задачи по важности и срочности, с дедлайнами и синхронизацией.">
<title>Матрица дел</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;450;500;600&display=swap">
<style>
  :root {
    --ground: #F3F4F1;
    --surface: #FFFFFF;
    --surface-2: #FAFAF7;
    --ink: #23261F;
    --muted: #797E70;
    --faint: #A7AC9F;
    --line: #E4E6DF;
    --line-strong: #D4D7CD;
    --accent: #3F6B4F;
    --accent-ink: #2C4E39;
    --accent-tint: #E7EEE8;
    --clay: #A6503C;
    --clay-tint: #F4E7E2;
    --amber: #97690F;
    --amber-tint: #F1EBD9;
    --danger: #A6503C;
    --shadow-sm: 0 1px 2px rgba(35,38,31,.05);
    --shadow: 0 1px 2px rgba(35,38,31,.05), 0 8px 24px -14px rgba(35,38,31,.24);
    --shadow-lg: 0 24px 60px -24px rgba(35,38,31,.42);
    --ease: cubic-bezier(.2,.7,.3,1);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #14160F;
      --surface: #1E211A;
      --surface-2: #191C15;
      --ink: #ECEDE6;
      --muted: #9BA091;
      --faint: #6E7365;
      --line: #2C3027;
      --line-strong: #3B4034;
      --accent: #84B893;
      --accent-ink: #A8D2B3;
      --accent-tint: #223026;
      --clay: #DB8C79;
      --clay-tint: #2E211C;
      --amber: #DFA64C;
      --amber-tint: #2B2416;
      --danger: #DB8C79;
      --shadow-sm: 0 1px 2px rgba(0,0,0,.3);
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 10px 30px -16px rgba(0,0,0,.6);
      --shadow-lg: 0 26px 64px -22px rgba(0,0,0,.75);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --ground: #14160F;
    --surface: #1E211A;
    --surface-2: #191C15;
    --ink: #ECEDE6;
    --muted: #9BA091;
    --faint: #6E7365;
    --line: #2C3027;
    --line-strong: #3B4034;
    --accent: #84B893;
    --accent-ink: #A8D2B3;
    --accent-tint: #223026;
    --clay: #DB8C79;
    --clay-tint: #2E211C;
    --amber: #DFA64C;
    --amber-tint: #2B2416;
    --danger: #DB8C79;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.3);
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 10px 30px -16px rgba(0,0,0,.6);
    --shadow-lg: 0 26px 64px -22px rgba(0,0,0,.75);
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }

  .wrap {
    max-width: 940px;
    margin: 0 auto;
    padding: max(18px, env(safe-area-inset-top)) clamp(14px, 4vw, 26px) calc(40px + env(safe-area-inset-bottom));
  }

  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; margin-bottom: 4px; }
  .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11.5px; letter-spacing: .18em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 5px;
  }
  h1 {
    font-family: "Fraunces", Georgia, serif;
    font-optical-sizing: auto; font-weight: 500;
    font-size: clamp(28px, 7vw, 40px); line-height: 1.0; letter-spacing: -.015em;
    margin: 0; text-wrap: balance;
  }
  h1 .accent { color: var(--accent); font-style: italic; }
  .theme-btn {
    flex: none; width: 38px; height: 38px; display: grid; place-items: center;
    border-radius: 10px; border: 1px solid var(--line-strong); background: var(--surface);
    color: var(--muted); cursor: pointer;
    transition: color .2s var(--ease), border-color .2s var(--ease), transform .15s var(--ease);
  }
  .theme-btn:hover { color: var(--ink); border-color: var(--accent); }
  .theme-btn:active { transform: scale(.93); }
  .theme-btn svg { width: 18px; height: 18px; }

  .summary {
    display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline;
    margin: 14px 2px 18px;
    font-family: "IBM Plex Mono", monospace; font-size: 12.5px; letter-spacing: .01em;
    color: var(--muted);
  }
  .summary b { color: var(--ink); font-weight: 500; }
  .summary .dot { color: var(--faint); }
  .summary .over { color: var(--danger); }
  .summary .over b { color: var(--danger); }

  .axis-x {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--faint); margin: 0 0 7px 26px;
  }
  .axis-x .line { flex: 1; height: 1px; background: var(--line); max-width: 90px; }

  .matrix-row { display: flex; align-items: stretch; gap: 8px; }
  .axis-y {
    flex: none; width: 18px; position: relative;
    font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--faint);
  }
  .axis-y span {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%) rotate(-90deg); transform-origin: center; white-space: nowrap;
  }

  .matrix { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; min-width: 0; }
  .quad {
    --qc: var(--muted); --qt: var(--surface-2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--qc);
    border-radius: 12px;
    padding: 11px 11px 13px;
    display: flex; flex-direction: column; gap: 9px;
    min-height: 148px; min-width: 0;
    box-shadow: var(--shadow-sm);
  }
  .quad.q-do    { --qc: var(--clay);   --qt: var(--clay-tint); }
  .quad.q-plan  { --qc: var(--accent); --qt: var(--accent-tint); }
  .quad.q-deleg { --qc: var(--amber);  --qt: var(--amber-tint); }
  .quad.q-later { --qc: var(--faint);  --qt: var(--surface-2); }

  .quad-head { position: relative; padding-right: 32px; }
  .quad-title { min-width: 0; }
  .quad-name {
    font-weight: 600; font-size: 13.5px; line-height: 1.15; color: var(--ink);
    display: flex; align-items: center; gap: 6px; overflow-wrap: anywhere;
  }
  .quad-name .swatch { width: 8px; height: 8px; border-radius: 2px; background: var(--qc); flex: none; }
  .quad-tags {
    font-family: "IBM Plex Mono", monospace; font-size: 10px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--muted); margin-top: 3px;
  }
  .quad-add {
    position: absolute; top: -1px; right: 0;
    width: 26px; height: 26px; border-radius: 7px;
    border: 1px solid var(--line-strong); background: var(--surface-2);
    color: var(--muted); cursor: pointer; display: grid; place-items: center; font-size: 17px; line-height: 1;
    transition: color .18s var(--ease), border-color .18s var(--ease), background .18s var(--ease);
  }
  .quad-add:hover { color: var(--qc); border-color: var(--qc); }
  .quad-add:active { transform: scale(.92); }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .chip {
    background: var(--surface-2); border: 1px solid var(--line);
    border-radius: 9px; padding: 8px 9px 8px 10px;
    display: flex; align-items: flex-start; gap: 8px; cursor: pointer;
    animation: pop .24s var(--ease);
    transition: border-color .16s var(--ease), background .16s var(--ease);
  }
  .chip:hover { border-color: var(--line-strong); }
  @keyframes pop { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: none; } }
  .chip-box {
    flex: none; margin-top: 1px; width: 18px; height: 18px; border-radius: 6px;
    border: 1.7px solid var(--line-strong); background: var(--surface);
    display: grid; place-items: center; cursor: pointer;
    transition: background .18s var(--ease), border-color .18s var(--ease);
  }
  .chip-box:hover { border-color: var(--qc); }
  .chip-box svg { width: 11px; height: 11px; stroke: #fff; opacity: 0; transform: scale(.5); transition: .16s var(--ease); }
  .chip.done .chip-box { background: var(--qc); border-color: var(--qc); }
  .chip.done .chip-box svg { opacity: 1; transform: none; }
  .chip-body { min-width: 0; flex: 1; }
  .chip-text { font-size: 13.5px; line-height: 1.3; word-break: break-word; }
  .chip.done .chip-text { color: var(--faint); text-decoration: line-through; text-decoration-color: var(--line-strong); }
  .chip-due {
    display: inline-flex; align-items: center; gap: 4px; margin-top: 5px;
    font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .02em;
    color: var(--muted); background: var(--surface); border: 1px solid var(--line);
    padding: 1px 6px; border-radius: 999px;
  }
  .chip-due svg { width: 10px; height: 10px; }
  .chip-due.soon { color: var(--amber); border-color: var(--amber); background: var(--amber-tint); }
  .chip-due.over { color: var(--danger); border-color: var(--danger); background: var(--clay-tint); }
  .chip.done .chip-due { color: var(--faint); border-color: var(--line); background: var(--surface); }
  .quad-empty { color: var(--faint); font-size: 12px; padding: 4px 2px 2px; font-style: italic; }

  .foot {
    margin-top: 22px; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 12px;
    font-family: "IBM Plex Mono", monospace; font-size: 11px; letter-spacing: .03em; color: var(--faint);
  }
  .sync { display: inline-flex; align-items: center; gap: 6px; }
  .sync .led { width: 7px; height: 7px; border-radius: 50%; background: var(--faint); flex: none; }
  .sync.ok  .led { background: var(--accent); }
  .sync.busy .led { background: var(--amber); animation: pulse 1s var(--ease) infinite; }
  .sync.off .led { background: var(--danger); }
  .sync.local .led { background: var(--faint); }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .3; } }

  .foot .sep { color: var(--line-strong); }

  /* editor sheet */
  .scrim {
    position: fixed; inset: 0; background: rgba(20,22,15,.42);
    backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
    display: flex; align-items: flex-end; justify-content: center; z-index: 40;
    opacity: 0; pointer-events: none; transition: opacity .22s var(--ease);
  }
  .scrim.open { opacity: 1; pointer-events: auto; }
  .sheet {
    width: 100%; max-width: 460px; background: var(--surface);
    border: 1px solid var(--line-strong); border-bottom: 0;
    border-radius: 18px 18px 0 0; box-shadow: var(--shadow-lg);
    padding: 16px clamp(14px,4vw,20px) calc(18px + env(safe-area-inset-bottom));
    transform: translateY(14px); transition: transform .26s var(--ease);
  }
  .scrim.open .sheet { transform: none; }
  .sheet-grip { width: 38px; height: 4px; border-radius: 999px; background: var(--line-strong); margin: 0 auto 12px; }
  @media (min-width: 560px) {
    .scrim { align-items: center; }
    .sheet { border-radius: 18px; border-bottom: 1px solid var(--line-strong); }
  }
  .field-label {
    font-family: "IBM Plex Mono", monospace; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--muted); margin: 14px 2px 6px;
  }
  .sheet textarea {
    width: 100%; border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--ink);
    border-radius: 11px; padding: 11px 12px; font: inherit; font-size: 16px; resize: none; outline: none;
    line-height: 1.35; min-height: 58px;
    transition: border-color .18s var(--ease);
  }
  .sheet textarea:focus { border-color: var(--accent); }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .seg button {
    border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--muted);
    border-radius: 10px; padding: 10px 8px; font: inherit; font-size: 14px; cursor: pointer;
    transition: .16s var(--ease);
  }
  .seg button[aria-pressed="true"] { color: var(--accent-ink); border-color: var(--accent); background: var(--accent-tint); font-weight: 500; }
  .seg.urg button[aria-pressed="true"] { color: var(--clay); border-color: var(--clay); background: var(--clay-tint); }
  .date-row { display: flex; gap: 8px; }
  .sheet input[type="date"] {
    flex: 1; border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--ink);
    border-radius: 10px; padding: 10px 12px; font: inherit; font-size: 15px; outline: none; min-width: 0;
    font-family: "IBM Plex Mono", monospace;
  }
  .sheet input[type="date"]:focus { border-color: var(--accent); }
  .date-clear {
    flex: none; border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--muted);
    border-radius: 10px; padding: 0 14px; font: inherit; font-size: 13px; cursor: pointer;
  }
  .date-clear:hover { color: var(--danger); border-color: var(--danger); }
  .sheet-actions { display: flex; gap: 8px; margin-top: 20px; }
  .btn {
    border: 0; border-radius: 11px; font: inherit; font-size: 15px; font-weight: 500;
    padding: 12px 16px; cursor: pointer; transition: .16s var(--ease);
  }
  .btn-primary { flex: 1; background: var(--accent); color: #fff; }
  :root[data-theme="dark"] .btn-primary { color: #14170F; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .btn-primary { color: #14170F; } }
  .btn-primary:hover { background: var(--accent-ink); }
  .btn-primary:active { transform: scale(.98); }
  .btn-del {
    flex: none; background: transparent; color: var(--danger);
    border: 1px solid var(--line-strong); font-weight: 450;
  }
  .btn-del:hover { border-color: var(--danger); background: var(--clay-tint); }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div>
      <p class="eyebrow">Матрица Эйзенхауэра</p>
      <h1>Матрица <span class="accent">дел</span></h1>
    </div>
    <button class="theme-btn" id="theme" type="button" aria-label="Сменить тему">
      <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></svg>
    </button>
  </header>

  <div class="summary" id="summary"></div>

  <div class="axis-x"><span class="line"></span>важность&nbsp;→<span class="line"></span></div>
  <div class="matrix-row">
    <div class="axis-y"><span>срочность&nbsp;↑</span></div>
    <div class="matrix" id="matrix">
      <section class="quad q-deleg" data-urgent="1" data-important="0">
        <div class="quad-head">
          <div class="quad-title">
            <div class="quad-name"><span class="swatch"></span>Делегировать</div>
            <div class="quad-tags">срочно · неважно</div>
          </div>
          <button class="quad-add" type="button" aria-label="Добавить">+</button>
        </div>
        <ul class="chips"></ul>
      </section>
      <section class="quad q-do" data-urgent="1" data-important="1">
        <div class="quad-head">
          <div class="quad-title">
            <div class="quad-name"><span class="swatch"></span>Сделать сейчас</div>
            <div class="quad-tags">срочно · важно</div>
          </div>
          <button class="quad-add" type="button" aria-label="Добавить">+</button>
        </div>
        <ul class="chips"></ul>
      </section>
      <section class="quad q-later" data-urgent="0" data-important="0">
        <div class="quad-head">
          <div class="quad-title">
            <div class="quad-name"><span class="swatch"></span>Потом</div>
            <div class="quad-tags">несрочно · неважно</div>
          </div>
          <button class="quad-add" type="button" aria-label="Добавить">+</button>
        </div>
        <ul class="chips"></ul>
      </section>
      <section class="quad q-plan" data-urgent="0" data-important="1">
        <div class="quad-head">
          <div class="quad-title">
            <div class="quad-name"><span class="swatch"></span>Запланировать</div>
            <div class="quad-tags">несрочно · важно</div>
          </div>
          <button class="quad-add" type="button" aria-label="Добавить">+</button>
        </div>
        <ul class="chips"></ul>
      </section>
    </div>
  </div>

  <p class="foot">
    <span class="sync local" id="sync"><span class="led"></span><span id="sync-text">локально</span></span>
    <span class="sep">·</span>
    <span id="count">0</span>
  </p>
</div>

<!-- editor -->
<div class="scrim" id="scrim" role="dialog" aria-modal="true" aria-label="Задача">
  <div class="sheet" id="sheet">
    <div class="sheet-grip"></div>
    <div class="field-label">Задача</div>
    <textarea id="e-text" rows="2" placeholder="Что нужно сделать…"></textarea>

    <div class="field-label">Важность</div>
    <div class="seg imp">
      <button type="button" data-imp="1" aria-pressed="false">Важно</button>
      <button type="button" data-imp="0" aria-pressed="false">Неважно</button>
    </div>

    <div class="field-label">Срочность</div>
    <div class="seg urg">
      <button type="button" data-urg="1" aria-pressed="false">Срочно</button>
      <button type="button" data-urg="0" aria-pressed="false">Несрочно</button>
    </div>

    <div class="field-label">Дедлайн</div>
    <div class="date-row">
      <input type="date" id="e-due">
      <button class="date-clear" id="e-due-clear" type="button">Убрать</button>
    </div>

    <div class="sheet-actions">
      <button class="btn btn-del" id="e-del" type="button">Удалить</button>
      <button class="btn btn-primary" id="e-save" type="button">Готово</button>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
(function () {
  "use strict";

  /* ═══════════════════════════════════════════════════════════════
     НАСТРОЙКА SUPABASE  —  вставьте два значения из вашего проекта.
     Где взять: панель Supabase → Project Settings → Data API / API keys.
     Пока значения не заменены, список работает только на этом устройстве.
     ═══════════════════════════════════════════════════════════════ */
  var SUPABASE_URL  = "https://wzlnenhtbfiaenverimv.supabase.co";   // напр. https://abcxyz.supabase.co
  var SUPABASE_ANON = "sb_publishable_xwf_Pk5ljsrkT_m58C7OLg_hDxVqoQ3";      // публичный anon-ключ (длинная строка)
  /* ═══════════════════════════════════════════════════════════════ */

  var TABLE = "lists";
  var KEY = "matrix-del.v1";

  var matrix = document.getElementById("matrix");
  var quads = Array.prototype.slice.call(matrix.querySelectorAll(".quad"));
  var summaryEl = document.getElementById("summary");
  var countEl = document.getElementById("count");
  var syncEl = document.getElementById("sync");
  var syncText = document.getElementById("sync-text");

  var seed = [
    { id: uid(), text: "Запланировать аудит на Комаровку", urgent: 1, important: 1, due: "", done: false },
    { id: uid(), text: "Переделать ДВР", urgent: 1, important: 1, due: "", done: false },
    { id: uid(), text: "Презентационные скиллы", urgent: 0, important: 1, due: "", done: false },
    { id: uid(), text: "Посмотреть выступления", urgent: 0, important: 1, due: "", done: false },
    { id: uid(), text: "Прочитать обучающие файлы", urgent: 0, important: 1, due: "", done: false },
    { id: uid(), text: "Shell Academy", urgent: 0, important: 0, due: "", done: false },
    { id: uid(), text: "Bearing SKF e-learning", urgent: 0, important: 0, due: "", done: false }
  ];

  /* ---------- identity: секретный ключ списка живёт в адресе (#l=...), не в репозитории ---------- */
  var listId = getListId();
  var cacheKey = KEY + ":" + listId;

  function getListId() {
    var m = (location.hash || "").match(/l=([A-Za-z0-9_-]{6,})/);
    var id = m ? m[1] : null;
    if (!id) { try { id = localStorage.getItem(KEY + ".listId"); } catch (e) {} }
    if (!id) { id = randomId(); }
    try { localStorage.setItem(KEY + ".listId", id); } catch (e) {}
    if (!/l=/.test(location.hash || "")) {
      try { history.replaceState(null, "", "#l=" + id); } catch (e) { location.hash = "l=" + id; }
    }
    return id;
  }
  function randomId() {
    var s = "";
    try {
      var a = new Uint8Array(12); crypto.getRandomValues(a);
      for (var i = 0; i < a.length; i++) s += (a[i] % 36).toString(36);
    } catch (e) { s = Math.random().toString(36).slice(2, 14); }
    return s;
  }
  function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }

  /* ---------- local cache ---------- */
  var tasks, lastUpdated;
  (function loadCache() {
    try {
      var raw = localStorage.getItem(cacheKey);
      if (raw) { var o = JSON.parse(raw); tasks = o.data || o; lastUpdated = o.updatedAt || "0"; return; }
    } catch (e) {}
    tasks = seed.slice(); lastUpdated = "0";
  })();
  function writeCache() {
    try { localStorage.setItem(cacheKey, JSON.stringify({ data: tasks, updatedAt: lastUpdated })); } catch (e) {}
  }

  /* ---------- cloud (Supabase) ---------- */
  var cloudOn = SUPABASE_URL.indexOf("http") === 0 && SUPABASE_ANON.length > 20 &&
                window.supabase && typeof window.supabase.createClient === "function";
  var db = cloudOn ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON) : null;

  function setSync(state, label) {
    syncEl.className = "sync " + state;
    syncText.textContent = label;
  }
  if (!cloudOn) setSync("local", "локально");
  else setSync("busy", "синхронизация…");

  function nowISO() { return new Date().toISOString(); }

  function push() {
    if (!db) { writeCache(); return; }
    setSync("busy", "сохранение…");
    db.from(TABLE).upsert({ id: listId, data: tasks, updated_at: lastUpdated })
      .then(function (res) {
        if (res && res.error) { setSync("off", "офлайн"); }
        else { setSync("ok", "синхронизировано"); }
      }, function () { setSync("off", "офлайн"); });
  }

  function pull(initial) {
    if (!db) return;
    db.from(TABLE).select("data, updated_at").eq("id", listId).maybeSingle()
      .then(function (res) {
        if (res && res.error) { setSync("off", "офлайн"); return; }
        var row = res && res.data;
        if (!row) {
          if (initial) { lastUpdated = nowISO(); writeCache(); push(); }  // первого списка ещё нет — создаём
          else setSync("ok", "синхронизировано");
          return;
        }
        var remoteAt = row.updated_at || "";
        if (remoteAt > lastUpdated && !editorOpen && Array.isArray(row.data)) {
          tasks = row.data; lastUpdated = remoteAt; writeCache(); render();
        }
        setSync("ok", "синхронизировано");
      }, function () { setSync("off", "офлайн"); });
  }

  function commitChange() {
    lastUpdated = nowISO();
    writeCache();
    push();
    render();
  }

  /* ---------- rendering ---------- */
  var fmt = null;
  try { fmt = new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "short" }); } catch (e) {}
  function todayStr() {
    var d = new Date(); d.setHours(0,0,0,0);
    return d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + String(d.getDate()).padStart(2,"0");
  }
  function daysTo(due) {
    if (!due) return null;
    var a = new Date(todayStr() + "T00:00:00"); var b = new Date(due + "T00:00:00");
    if (isNaN(b)) return null;
    return Math.round((b - a) / 86400000);
  }
  function dueLabel(due) {
    var d = daysTo(due);
    if (d === null) return { text: "", cls: "" };
    var b = new Date(due + "T00:00:00");
    var nice = fmt ? fmt.format(b) : due;
    if (d < 0) return { text: "просрочено · " + nice, cls: "over" };
    if (d === 0) return { text: "сегодня", cls: "over" };
    if (d === 1) return { text: "завтра · " + nice, cls: "soon" };
    if (d <= 3) return { text: "через " + d + " дн · " + nice, cls: "soon" };
    return { text: "до " + nice, cls: "" };
  }
  function svgCheck() { return '<svg viewBox="0 0 24 24" fill="none" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>'; }
  function svgClock() { return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'; }

  function render() {
    quads.forEach(function (q) {
      var u = q.dataset.urgent, i = q.dataset.important;
      var ul = q.querySelector(".chips");
      ul.innerHTML = "";
      var here = tasks.filter(function (t) { return String(t.urgent) === u && String(t.important) === i; });
      here.sort(function (a, b) {
        if (a.done !== b.done) return a.done ? 1 : -1;
        var da = daysTo(a.due), dbb = daysTo(b.due);
        if (da === null && dbb === null) return 0;
        if (da === null) return 1;
        if (dbb === null) return -1;
        return da - dbb;
      });
      if (!here.length) {
        var e = document.createElement("li");
        e.className = "quad-empty"; e.textContent = "пусто";
        ul.appendChild(e); return;
      }
      here.forEach(function (t) {
        var li = document.createElement("li");
        li.className = "chip" + (t.done ? " done" : "");
        var box = document.createElement("button");
        box.className = "chip-box"; box.type = "button";
        box.setAttribute("aria-label", t.done ? "Снять отметку" : "Выполнено");
        box.innerHTML = svgCheck();
        box.addEventListener("click", function (ev) { ev.stopPropagation(); toggle(t.id); });
        var body = document.createElement("div");
        body.className = "chip-body";
        var tx = document.createElement("div");
        tx.className = "chip-text"; tx.textContent = t.text;
        body.appendChild(tx);
        var dl = dueLabel(t.due);
        if (dl.text) {
          var due = document.createElement("span");
          due.className = "chip-due " + dl.cls;
          due.innerHTML = svgClock() + "<span></span>";
          due.lastChild.textContent = dl.text;
          body.appendChild(due);
        }
        li.appendChild(box); li.appendChild(body);
        li.addEventListener("click", function () { openEditor(t.id); });
        ul.appendChild(li);
      });
    });

    var total = tasks.length;
    var done = tasks.filter(function (t) { return t.done; }).length;
    var over = tasks.filter(function (t) { return !t.done && daysTo(t.due) !== null && daysTo(t.due) < 0; }).length;
    var soon = tasks.filter(function (t) { var d = daysTo(t.due); return !t.done && d !== null && d >= 0 && d <= 3; }).length;
    var parts = [];
    parts.push("<span><b>" + (total - done) + "</b> активных</span>");
    parts.push('<span class="dot">·</span><span><b>' + done + "</b> готово</span>");
    if (over) parts.push('<span class="dot">·</span><span class="over"><b>' + over + "</b> просрочено</span>");
    if (soon) parts.push('<span class="dot">·</span><span><b>' + soon + "</b> скоро</span>");
    summaryEl.innerHTML = parts.join("");
    countEl.textContent = total === 1 ? "1 задача" : (total + " задач");
  }

  function toggle(id) { tasks.forEach(function (t) { if (t.id === id) t.done = !t.done; }); commitChange(); }

  /* ---------- editor ---------- */
  var scrim = document.getElementById("scrim");
  var eText = document.getElementById("e-text");
  var eDue = document.getElementById("e-due");
  var eDueClear = document.getElementById("e-due-clear");
  var eSave = document.getElementById("e-save");
  var eDel = document.getElementById("e-del");
  var impBtns = Array.prototype.slice.call(document.querySelectorAll(".seg.imp button"));
  var urgBtns = Array.prototype.slice.call(document.querySelectorAll(".seg.urg button"));
  var editingId = null, editorOpen = false, draftImp = 1, draftUrg = 1;

  function paintSeg() {
    impBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(Number(b.dataset.imp) === draftImp)); });
    urgBtns.forEach(function (b) { b.setAttribute("aria-pressed", String(Number(b.dataset.urg) === draftUrg)); });
  }
  impBtns.forEach(function (b) { b.addEventListener("click", function () { draftImp = Number(b.dataset.imp); paintSeg(); }); });
  urgBtns.forEach(function (b) { b.addEventListener("click", function () { draftUrg = Number(b.dataset.urg); paintSeg(); }); });
  eDueClear.addEventListener("click", function () { eDue.value = ""; });

  function openEditor(id) {
    var t = tasks.filter(function (x) { return x.id === id; })[0];
    if (!t) return;
    editingId = id; editorOpen = true;
    eText.value = t.text; eDue.value = t.due || "";
    draftImp = t.important; draftUrg = t.urgent; paintSeg();
    scrim.classList.add("open");
    setTimeout(function () { if (!t.text) eText.focus(); }, 260);
  }
  function closeEditor() { scrim.classList.remove("open"); editingId = null; editorOpen = false; pull(false); }

  function commit() {
    if (editingId === null) { closeEditor(); return; }
    var text = eText.value.trim();
    if (!text) { tasks = tasks.filter(function (t) { return t.id !== editingId; }); }
    else {
      tasks.forEach(function (t) {
        if (t.id === editingId) { t.text = text; t.important = draftImp; t.urgent = draftUrg; t.due = eDue.value || ""; }
      });
    }
    var keep = editingId; editingId = null; editorOpen = false;
    scrim.classList.remove("open");
    void keep;
    commitChange();
  }
  eSave.addEventListener("click", commit);
  eDel.addEventListener("click", function () {
    if (editingId === null) return;
    tasks = tasks.filter(function (t) { return t.id !== editingId; });
    editingId = null; editorOpen = false; scrim.classList.remove("open");
    commitChange();
  });
  scrim.addEventListener("click", function (ev) { if (ev.target === scrim) commit(); });
  document.addEventListener("keydown", function (ev) { if (ev.key === "Escape" && scrim.classList.contains("open")) commit(); });

  quads.forEach(function (q) {
    q.querySelector(".quad-add").addEventListener("click", function () {
      var t = { id: uid(), text: "", urgent: Number(q.dataset.urgent), important: Number(q.dataset.important), due: "", done: false };
      tasks.push(t); openEditor(t.id);
    });
  });

  /* ---------- theme ---------- */
  var sun = '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.5M12 19v2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M2.5 12H5M19 12h2.5M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/>';
  var moon = '<path d="M20 14.5A8 8 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5z"/>';
  var icon = document.getElementById("theme-icon");
  var stored = null;
  try { stored = localStorage.getItem(KEY + ".theme"); } catch (e) {}
  if (stored === "dark" || stored === "light") document.documentElement.setAttribute("data-theme", stored);
  function isDark() {
    var t = document.documentElement.getAttribute("data-theme");
    if (t) return t === "dark";
    return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
  }
  function paintIcon() { icon.innerHTML = isDark() ? sun : moon; }
  paintIcon();
  document.getElementById("theme").addEventListener("click", function () {
    var next = isDark() ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try { localStorage.setItem(KEY + ".theme", next); } catch (e) {}
    paintIcon();
  });
  try {
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function () {
      if (!document.documentElement.getAttribute("data-theme")) paintIcon();
    });
  } catch (e) {}

  /* ---------- go ---------- */
  render();
  if (cloudOn) {
    pull(true);
    setInterval(function () { if (!editorOpen) pull(false); }, 6000);
    document.addEventListener("visibilitychange", function () { if (!document.hidden) pull(false); });
    window.addEventListener("focus", function () { pull(false); });
  }
})();
</script>
</body>
</html>
